rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    match /users/{userId} { allow read, write: if owner(userId); }
    match /analysisSessions/{sessionId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /results/{resultId} { allow read, write: if signedIn() && get(/databases/$(database)/documents/analysisSessions/$(sessionId)).data.ownerId == request.auth.uid; }
    }
    match /projects/{projectId} { allow read, write: if signedIn() && request.resource.data.members[request.auth.uid] in ['owner', 'analyst', 'reviewer']; }
    match /{document=**} { allow read, write: if false; }
  }
}
